# =====================================================
# Tomato Disease Detection API - Environment Variables
# Copiar a .env y completar valores reales
# =====================================================

# --- App ---
ENVIRONMENT=development
DEBUG=true
APP_NAME="Tomate Disease Detection API"
APP_VERSION=2.0.0

# --- Server ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# --- Database (PostgreSQL / Supabase) ---
# Ejemplo local:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tomate_db
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/tomate_db
# Ejemplo Supabase:
# DATABASE_URL=postgresql+asyncpg://postgres.xxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# DATABASE_URL_SYNC=postgresql://postgres.xxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# --- Supabase Storage ---
SUPABASE_URL=https://xyzabcdef.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-key
SUPABASE_BUCKET=diagnostic-images

# --- JWT ---
JWT_SECRET_KEY=change-me-super-secret-key-min-32-chars-production
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_HOURS=8
JWT_REFRESH_EXPIRE_DAYS=30

# --- Model ---
MODEL_PATH=app/models/best.pt
MAX_UPLOAD_SIZE_MB=5
CONFIDENCE_THRESHOLD=0.40
IOU_THRESHOLD=0.45

# --- CORS ---
# Desarrollo: "*" | Producción: lista separada por comas
CORS_ORIGINS=*

# --- Rate limiting ---
RATE_LIMIT_LOGIN=5/minute
